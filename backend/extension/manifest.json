{
  "manifest_version": 3,
  "name": "RecTracker (API Connected)",
  "version": "1.0.0",
  "description": "Track, understand, and control your YouTube recommendations — synced with AI backend.",
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "RecTracker"
  }
}
