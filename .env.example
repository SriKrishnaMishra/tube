# ==============================================================================
# API Keys & Credentials Configuration
# Copy this file to .env and set your keys:
# ==============================================================================

# Groq LLM API Key (Fastest inference: llama-3.3-70b-versatile, llama-3.1-8b-instant)
GROQ_API_KEY=your_groq_api_key_here

# Alternative Providers (optional fallbacks)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Multi-Website Posting Credentials (optional, per target platform)
# WordPress
WP_DEFAULT_USER=
WP_DEFAULT_APP_PASS=

# Ghost CMS
GHOST_DEFAULT_ADMIN_KEY=

